            "uid": "prometheus"
          },
          "expr": "sum by (service, status_code) (rate(http_server_request_duration_seconds_count{service=~\"$service\", status_code=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{status_code}}"
