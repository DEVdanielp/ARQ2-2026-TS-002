          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(process_resident_memory_bytes{job=\"services\"}, service)",
          "refId": "service"
        },
        "definition": "label_values(process_resident_memory_bytes{job=\"services\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
