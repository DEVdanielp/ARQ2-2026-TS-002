        "x": 18,
        "y": 15,
        "w": 6,
        "h": 8
      },
      "type": "timeseries",
      "title": "Procesamiento de un lote en el worker (p95)",
      "description": "Transacción completa: lock del conductor, historial, ubicación, NEARBY y outbox.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kafka_message_processing_duration_seconds_bucket{service=\"gps-tracking-worker\", topic=\"gps.batches\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
