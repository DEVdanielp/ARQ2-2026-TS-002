    {
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "type": "timeseries",
      "title": "Recorrido de un lote GPS",
      "description": "Ingestion publica en gps.batches → el worker lo consume → publica tracking.locations → Tracking Query lo consume. Si una curva se separa de la anterior, ahí hay un cuello de botella.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(kafka_messages_published_total{service=\"gps-ingestion-api\", topic=\"gps.batches\", result=\"ok\"}[$__rate_interval]))",
          "legendFormat": "1 · gps.batches publicados (ingestion)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(kafka_messages_consumed_total{service=\"gps-tracking-worker\", topic=\"gps.batches\"}[$__rate_interval]))",
          "legendFormat": "2 · gps.batches consumidos (worker)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(kafka_messages_published_total{service=\"gps-tracking-worker\", topic=\"tracking.locations\", result=\"ok\"}[$__rate_interval]))",
          "legendFormat": "3 · tracking.locations publicados (worker)"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(kafka_messages_consumed_total{service=\"tracking-query-service\", topic=\"tracking.locations\"}[$__rate_interval]))",
          "legendFormat": "4 · tracking.locations consumidos (tracking query)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
