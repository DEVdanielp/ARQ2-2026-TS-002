# Copy to .env (same folder) to run the worker on the host:
#   npx nest build gps-tracking-worker
#   node dist/apps/gps-tracking-worker/main.js
# In Docker these values come from docker-compose.yml instead.
# The worker has no HTTP port: it only consumes Kafka.
DATABASE_URL=postgres://tracking_db:fasttrack@localhost:5432/tracking_db
KAFKA_BROKERS=localhost:9092
# NEARBY thresholds (spec 5.4)
NEARBY_DISTANCE_METERS=500
NEARBY_ETA_SECONDS=300
# Maps/ETA provider; empty = NEARBY by distance only (ADR-013). Contract: ADR-018.
ETA_PROVIDER_URL=
# Optional (ADR-013 defaults):
# ETA_LOOKUP_RADIUS_METERS=3000
# ETA_MIN_INTERVAL_SECONDS=60
# ETA_TIMEOUT_MS=2000
