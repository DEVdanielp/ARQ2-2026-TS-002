# Copy to .env (same folder) to run the worker on the host:
#   npx nest build gps-tracking-worker
#   node dist/apps/gps-tracking-worker/main.js
# In Docker these values come from docker-compose.yml instead.
# The worker has no HTTP port: it only consumes Kafka.
DATABASE_URL=postgres://tracking_db:fasttrack@localhost:5432/tracking_db
KAFKA_BROKERS=localhost:9092
# NEARBY thresholds (spec 5.4)
NEARBY_DISTANCE_METERS=500
NEARBY_ETA_SECONDS=300
# Maps/ETA provider (ADR-020): openrouteservice | osrm | http | none.
# Empty = automatic: ORS_API_KEY set -> openrouteservice; ETA_PROVIDER_URL set -> http; else distance only.
# Free key (no card): sign up at https://openrouteservice.org and copy it from the dashboard.
# Keyless option for local demos (non-commercial, 1 req/s): ETA_PROVIDER=osrm
ETA_PROVIDER=
ORS_API_KEY=
# http: endpoint of the ADR-018 contract. openrouteservice/osrm: base URL of a self-hosted instance.
ETA_PROVIDER_URL=
# Optional (ADR-020 defaults): driving-car / driving; local caps = the provider's free limits
# ETA_ROUTING_PROFILE=driving-car
# ETA_RATE_LIMIT_PER_MINUTE=40
# ETA_DAILY_QUOTA=2000
# Optional (ADR-013 defaults):
# ETA_LOOKUP_RADIUS_METERS=3000
# ETA_MIN_INTERVAL_SECONDS=60
# ETA_TIMEOUT_MS=2000
