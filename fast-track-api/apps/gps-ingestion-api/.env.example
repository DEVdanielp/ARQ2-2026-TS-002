# Copy to .env (same folder) to run the service on the host:
#   npx nest build gps-ingestion-api
#   node dist/apps/gps-ingestion-api/main.js
# In Docker these values come from docker-compose.yml instead.
port=3010
KAFKA_BROKERS=localhost:9092
# Optional: wait for Kafka's acknowledgement before answering 503 (default 5000 ms)
# GPS_PUBLISH_TIMEOUT_MS=5000
# Optional: false turns off the Swagger UI at /v1/gps-ingestion/docs
# SWAGGER_ENABLED=true
