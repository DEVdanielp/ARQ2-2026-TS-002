# Copy to .env (same folder) to run the service on the host:
#   npx nest build profiles-service
#   node dist/apps/profiles-service/main.js
# In Docker these values come from docker-compose.yml instead.
port=3050
DATABASE_URL=postgres://profiles_db:fasttrack@localhost:5432/profiles_db
KAFKA_BROKERS=localhost:9092
# Optional (spec defaults). Shorten locally to watch retries and AssignmentFailed in seconds:
# ASSIGNMENT_RETRY_SECONDS=30
# ASSIGNMENT_WINDOW_SECONDS=600
# ASSIGNMENT_SCHEDULER_INTERVAL_MS=1000
# DEFAULT_DRIVER_CAPACITY=3
