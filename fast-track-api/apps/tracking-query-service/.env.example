# Copy to .env (same folder) to run the service on the host:
#   npx nest build tracking-query-service
#   node dist/apps/tracking-query-service/main.js
# In Docker these values come from docker-compose.yml instead.
# Also used by `npm run openapi:tracking-query-service` (nothing is connected then).
port=3040
DATABASE_URL=postgres://query_archive_db:fasttrack@localhost:5432/query_archive_db
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092
# How long DELIVERED/CANCELLED views stay in Redis (default 86400 = 24 h). Shorten locally to test F3-S5:
# TERMINAL_VIEW_TTL_SECONDS=60
