# Copy to .env (same folder) to run the service on the host:
#   npx nest build notification-service
#   node dist/apps/notification-service/main.js
# In Docker these values come from docker-compose.yml instead.
port=3020
DATABASE_URL=postgres://notifications_db:fasttrack@localhost:5432/notifications_db
KAFKA_BROKERS=localhost:9092
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@fasttrack.local
# Empty = push notifications are logged instead of sent
FCM_CREDENTIALS_FILE=
OPS_ALERT_EMAIL=ops@fasttrack.local
# Waits before retry 1,2,3 in seconds (default 60,300,900). Shorten locally to test retries:
# NOTIFICATION_RETRY_BACKOFF_SECONDS=5,10,15
