{
  "openapi": "3.0.0",
  "paths": {
    "/v1/orders": {
      "post": {
        "description": "Role `CUSTOMER`. Creates the order in `CREATED` and publishes `OrderCreated` through the outbox, which starts the fulfillment saga: Profiles & Assignment looks for a driver.",
        "operationId": "OrdersController_create",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Optional. A repeated key within 24 h returns the original response without repeating the action.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "headers": {
              "Location": {
                "description": "Path of the new order",
                "schema": {
                  "type": "string",
                  "example": "/v1/orders/6f1c2b7e-8d4a-4f3b-9e21-0c5a7d8e9f10"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid destination",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                },
                "examples": {
                  "example": {
                    "value": {
                      "type": "https://api.fasttrack.local/errors/validation",
                      "title": "Invalid request",
                      "status": 400,
                      "detail": "One or more fields are invalid.",
                      "instance": "/v1/orders",
                      "correlationId": "0b7d0c1e-3a55-4b8e-9d2b-5f0c2a9a7e11",
                      "errors": [
                        {
                          "field": "destination.location.lat",
                          "message": "lat must not be greater than 90"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid JWT (returned by Kong)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not a customer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                },
                "examples": {
                  "example": {
                    "value": {
                      "type": "https://api.fasttrack.local/errors/forbidden",
                      "title": "Forbidden",
                      "status": 403,
                      "detail": "Requires one of the roles: CUSTOMER",
                      "instance": "/v1/orders",
                      "correlationId": "0b7d0c1e-3a55-4b8e-9d2b-5f0c2a9a7e11"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Same `Idempotency-Key` with a different body",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                },
                "examples": {
                  "example": {
                    "value": {
                      "type": "https://api.fasttrack.local/errors/idempotency-key-reused",
                      "title": "Idempotency key reused",
                      "status": 409,
                      "detail": "Idempotency-Key 1f6e0c2a-77b1-4d0e-9a8f-2b3c4d5e6f70 was already used with a different body.",
                      "instance": "/v1/orders",
                      "correlationId": "0b7d0c1e-3a55-4b8e-9d2b-5f0c2a9a7e11"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (Kong)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is temporarily unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create an order",
        "tags": [
          "Orders"
        ]
      },
      "get": {
        "description": "A customer sees their own orders, a driver the ones assigned to them, and operations sees all. Newest first.",
        "operationId": "OrdersController_list",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "example": "ON_THE_WAY",
              "type": "string",
              "enum": [
                "CREATED",
                "ON_THE_WAY",
                "DELIVERED",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Starts at 0",
            "schema": {
              "minimum": 0,
              "default": 0,
              "type": "number"
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPageDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                },
                "examples": {
                  "example": {
                    "value": {
                      "type": "https://api.fasttrack.local/errors/validation",
                      "title": "Invalid request",
                      "status": 400,
                      "detail": "One or more fields are invalid.",
                      "instance": "/v1/orders?status=LOST",
                      "correlationId": "0b7d0c1e-3a55-4b8e-9d2b-5f0c2a9a7e11",
                      "errors": [
                        {
                          "field": "status",
                          "message": "status must be one of the following values: CREATED, ON_THE_WAY, DELIVERED, CANCELLED"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid JWT (returned by Kong)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "403": {
            "description": "Valid JWT but the role or ownership does not allow the action",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (Kong)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List the caller's orders",
        "tags": [
          "Orders"
        ]
      }
    },
