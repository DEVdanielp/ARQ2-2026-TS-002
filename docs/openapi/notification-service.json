          },
          "401": {
            "description": "Missing, expired or invalid JWT (returned by Kong)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "403": {
            "description": "Valid JWT but the role or ownership does not allow the action",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Replace the caller's notification preferences",
        "tags": [
          "Notifications"
        ]
      }
    },
    "/v1/notifications/devices": {
      "put": {
        "description": "Role `CUSTOMER`. Idempotent. A token already registered by another account moves to the caller (same phone, new login).",
        "operationId": "NotificationsController_putDevice",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
