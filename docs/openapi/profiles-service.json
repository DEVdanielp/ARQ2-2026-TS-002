    "/v1/drivers/me/availability": {
      "patch": {
        "description": "Role `DRIVER`. `EN_ROUTE` is set by the system: an `AVAILABLE` driver with active orders is shown as `EN_ROUTE` and can still receive orders while they have a free slot.\n\n- `AVAILABLE`: orders waiting for a driver can be assigned to them at their next attempt (every 30 s).\n- `OFFLINE`: refused with `409` while one of their orders is `ON_THE_WAY`. Every order still `CREATED` is released: `DriverUnassigned` is published (`assignment.events`, reason `DRIVER_OFFLINE`) and its assignment restarts with a new 10-minute window, ending in `DriverAssigned` or `AssignmentFailed` (F1-S6, saga compensation).",
        "operationId": "DriversController_patchAvailability",
        "parameters": [
          {
            "name": "x-correlation-id",
            "required": false,
            "in": "header",
            "description": "Added by Kong; copied into the events",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeAvailabilityDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverDto"
                },
                "example": {
                  "driverId": "9a1b2c3d-4e5f-4a6b-8c7d-0e1f2a3b4c5d",
                  "name": "Carlos Ruiz",
                  "phone": "+573109876543",
                  "vehiclePlate": "ABC123",
                  "availability": "AVAILABLE",
                  "capacity": 3,
                  "activeOrderIds": []
                }
              }
            }
          },
          "400": {
            "description": "Invalid value (EN_ROUTE cannot be requested)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                },
                "example": {
                  "type": "https://api.fasttrack.local/errors/validation",
                  "title": "Invalid request",
                  "status": 400,
                  "detail": "One or more fields are invalid.",
                  "instance": "/v1/drivers/me/availability",
                  "correlationId": "0b7d0c1e-3a55-4b8e-9d2b-5f0c2a9a7e11",
                  "errors": [
                    {
                      "field": "availability",
                      "message": "availability must be AVAILABLE or OFFLINE (EN_ROUTE is set by the system)"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid JWT (returned by Kong)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "403": {
            "description": "Valid JWT but the role or ownership does not allow the action",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "404": {
            "description": "The driver profile does not exist (use PUT /drivers/me)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                },
                "example": {
                  "type": "https://api.fasttrack.local/errors/not-found",
                  "title": "Not Found",
                  "status": 404,
                  "detail": "Driver profile not created yet",
                  "instance": "/v1/drivers/me/availability",
                  "correlationId": "0b7d0c1e-3a55-4b8e-9d2b-5f0c2a9a7e11"
