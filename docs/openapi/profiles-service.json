  "info": {
    "title": "FastTrack · Profiles & Assignment Service",
    "description": "Profiles & Assignment Service (feature **F1**). Customer and driver profiles,\ndriver availability and capacity, and the assignment of every new order to an\navailable driver (step 2 of the order fulfillment saga, ADR-016). Owns\n`profiles-db`. Contract: `docs/spec.md` §4.1, §5.4, F1; decisions in ADR-019.\n\n### Authentication\nEvery endpoint needs `Authorization: Bearer <JWT>` issued by Keycloak. Kong\nverifies the token; the service checks the role (`realm_access.roles`) and\nalways takes the customer/driver id from the token's `sub`.\n\n### Errors\nAll errors are `application/problem+json` (schema `ProblemDetailsDto`), with\nthe `correlationId` from `X-Correlation-Id`.\n\n### How a driver is chosen (ADR-019)\nEligible = not `OFFLINE` and fewer active orders than their capacity\n(`EN_ROUTE` drivers with a free slot are eligible). Among them: fewest active\norders, then the one whose last assignment is oldest. If nobody is eligible the\norder is retried every **30 s**; after **10 min** `AssignmentFailed` is\npublished and the order stays `CREATED`.\n\n### Events consumed (Kafka, consumer group `profiles-service`)\n| Topic | Event | Effect |\n| --- | --- | --- |\n| `orders.events` | `OrderCreated` | stores the order and its destination; assigns a driver at once or starts the retries |\n| `orders.events` | `OrderOnTheWay` | the order is picked up: its driver can no longer go `OFFLINE` (409) |\n| `orders.events` | `OrderDelivered`, `OrderCancelled` | releases the driver's slot; back to `AVAILABLE` with no active orders; stops the retries |\n\n### Events produced (through the transactional outbox)\n| Topic (key) | Event | When |\n| --- | --- | --- |\n| `assignment.events` (orderId) | `DriverAssigned` | a driver was assigned (payload: driverName, destination.location, assignedAt) |\n| `assignment.events` (orderId) | `DriverUnassigned` | the driver went `OFFLINE` before pickup (reason `DRIVER_OFFLINE`); the assignment restarts |\n| `assignment.events` (orderId) | `AssignmentFailed` | no driver within 10 minutes; the order stays `CREATED` |\n| `profile.events` (customerId) | `CustomerContactUpdated` | a customer profile was created, or its email/phone changed (`aggregateVersion` increases) |",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Customers",
      "description": "Customer profile of the caller (spec 4.1)"
    },
    {
      "name": "Drivers",
      "description": "Driver profile, availability and capacity (spec 4.1)"
    },
    {
      "name": "Assignments",
      "description": "Order-to-driver assignments, for operations (spec 4.1)"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "API Gateway (Kong)"
    },
    {
      "url": "http://localhost:3050",
      "description": "Profiles Service run on the host (no Kong; see libs/auth README)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Keycloak access token"
      }
    },
    "schemas": {
      "CustomerDto": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid",
            "example": "3c9f8a2e-1b7d-4c55-9a0e-6d2f4b1e7a10",
            "description": "Equals the JWT sub"
          },
          "name": {
            "type": "string",
            "example": "Laura Gómez"
          },
          "email": {
            "type": "string",
            "example": "laura@example.com",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "example": "+573001234567"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-18T15:00:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-18T15:00:00Z"
          }
        },
        "required": [
          "customerId",
          "name",
          "email",
          "phone",
          "createdAt",
          "updatedAt"
        ]
      },
      "SaveCustomerProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Laura Gómez",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "example": "laura@example.com",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "example": "+573001234567",
            "pattern": "^\\+[1-9]\\d{6,14}$",
            "description": "International format. PUT replaces the profile: omitted = no phone"
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "SaveDriverProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Carlos Ruiz",
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "example": "+573109876543",
            "pattern": "^\\+[1-9]\\d{6,14}$"
          },
          "vehiclePlate": {
            "type": "string",
            "example": "ABC123",
            "maxLength": 16
          }
        },
        "required": [
          "name",
          "phone",
          "vehiclePlate"
        ]
      },
      "DriverDto": {
        "type": "object",
        "properties": {
          "driverId": {
            "type": "string",
            "format": "uuid",
            "example": "9a1b2c3d-4e5f-4a6b-8c7d-0e1f2a3b4c5d",
            "description": "Equals the JWT sub"
          },
          "name": {
            "type": "string",
            "example": "Carlos Ruiz"
          },
          "phone": {
            "type": "string",
            "example": "+573109876543"
          },
          "vehiclePlate": {
            "type": "string",
            "example": "ABC123"
          },
          "availability": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "EN_ROUTE",
              "OFFLINE"
            ],
            "example": "AVAILABLE",
            "description": "AVAILABLE = no active orders · EN_ROUTE = has active orders (set by the system) · OFFLINE = receives nothing"
          },
          "capacity": {
            "type": "number",
            "minimum": 1,
            "maximum": 10,
            "example": 3,
            "description": "Max concurrent orders"
          },
          "activeOrderIds": {
            "example": [],
            "description": "Orders currently assigned to the driver",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "driverId",
          "name",
          "phone",
          "vehiclePlate",
          "availability",
          "capacity",
          "activeOrderIds"
        ]
      },
      "ChangeAvailabilityDto": {
        "type": "object",
        "properties": {
          "availability": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "OFFLINE"
            ],
            "example": "AVAILABLE",
            "description": "`EN_ROUTE` cannot be requested: the system sets it while the driver has active orders"
          }
        },
        "required": [
          "availability"
        ]
      },
      "ChangeCapacityDto": {
        "type": "object",
        "properties": {
          "capacity": {
            "type": "number",
            "minimum": 1,
            "maximum": 10,
            "example": 4,
            "description": "Max concurrent orders"
          }
        },
        "required": [
          "capacity"
        ]
      },
      "AssignmentDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid",
            "example": "6f1c2b7e-8d4a-4f3b-9e21-0c5a7d8e9f10"
          },
          "driverId": {
            "type": "string",
            "format": "uuid",
            "example": "9a1b2c3d-4e5f-4a6b-8c7d-0e1f2a3b4c5d"
          },
          "assignedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-18T15:01:10Z"
          },
          "releasedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": null,
            "description": "When the driver stopped having the order (delivered, cancelled, or released because the driver went OFFLINE); null while active"
          }
        },
        "required": [
          "orderId",
          "driverId",
          "assignedAt",
          "releasedAt"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "push"
          },
          "message": {
            "type": "string",
            "example": "push must be a boolean value"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://api.fasttrack.local/errors/validation"
          },
          "title": {
            "type": "string",
            "example": "Invalid request"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "One or more fields are invalid."
          },
          "instance": {
            "type": "string",
            "example": "/v1/notifications/preferences"
          },
          "correlationId": {
            "type": "string",
            "example": "0b7d0c1e-3a55-4b8e-9d2b-5f0c2a9a7e11",
            "description": "Copied from X-Correlation-Id"
          },
          "errors": {
            "description": "Only for validation errors",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance"
        ]
      }
    }
  }
}
