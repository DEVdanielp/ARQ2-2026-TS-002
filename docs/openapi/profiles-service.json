                "example": {
                  "type": "https://api.fasttrack.local/errors/orders-on-the-way",
                  "title": "Driver has orders on the way",
                  "status": 409,
                  "detail": "Cannot go OFFLINE with orders ON_THE_WAY: 6f1c2b7e-8d4a-4f3b-9e21-0c5a7d8e9f10.",
                  "instance": "/v1/drivers/me/availability",
                  "correlationId": "0b7d0c1e-3a55-4b8e-9d2b-5f0c2a9a7e11"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
